# Copia este fichero como .env y ajusta los valores.
# .env NO se sube al repositorio (contiene la contraseña de la BD).

# --- Colector ---------------------------------------------------------------

# Distancia (en metros) por debajo de la cual se genera una alerta entre dos trenes
ALERT_DISTANCE_METERS=1000

# true: no se generan alertas si los DOS trenes están parados (STOPPED_AT), p. ej. en una estación.
# false: regla estricta del enunciado (cualquier par por debajo del umbral es alerta).
ALERT_IGNORE_BOTH_STOPPED=true

# Segundos entre lecturas del feed (mínimo 15: la fuente se actualiza cada ~15 s)
POLL_INTERVAL_SECONDS=15

# Opcional: ruta a un JSON local para trabajar sin conexión en vez de llamar a la API
# FEED_FILE=samples/vehicle_positions_sample.json

# --- Backend ----------------------------------------------------------------

# Una posición más antigua que esto (segundos) no se considera "reciente" en /getDistancia
MAX_POSITION_AGE_SECONDS=120

# --- Base de datos (PostgreSQL) ---------------------------------------------

POSTGRES_DB=renfe
POSTGRES_USER=renfe
POSTGRES_PASSWORD=cambia_esta_password
